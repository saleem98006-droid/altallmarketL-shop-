Future<void> _saveChanges() async {
  if (_formKey.currentState!.validate()) {

    setState(() => isSaving = true); // 🟢 بدأ التحميل

    final prefs = await SharedPreferences.getInstance();
    final shopId = prefs.getInt('shopId') ?? 0;

    if (shopId == 0) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text("⚠️ لم يتم العثور على معرف المحل")),
      );
      setState(() => isSaving = false); // 🔵 إيقاف التحميل
      Navigator.pop(context, false);
      return;
    }

    // 🏪 البيانات الجديدة للمحل
    final Map<String, dynamic> updatedData = {
  "shopName": _nameController.text,
  "address": _addressController.text,
  "detailes": _detailsController.text,
  "phoneNumbers": phoneControllers.map((c) => c.text).toList(),
  
};
// صورة الغلاف
if (coverImageDeleted) {
  updatedData["shopImageBase64"] = null; // 🔥 حذف صريح
} else if (coverImageBase64 != null) {
  updatedData["shopImageBase64"] = coverImageBase64; // صورة جديدة
} else {
  // لم تُعدّل الصورة في الواجهة → نرسل القديمة كما هي
  updatedData["shopImageBase64"] = shopData?["shopImageBase64"];
}

// الصورة الدائرية
if (avatarImageDeleted) {
  updatedData["shopImage2Base64"] = null; // 🔥 حذف صريح
} else if (avatarImageBase64 != null) {
  updatedData["shopImage2Base64"] = avatarImageBase64;
} else {
  updatedData["shopImage2Base64"] = shopData?["shopImage2Base64"];
}

final oldCover = shopData?["shopImageBase64"];
final oldAvatar = shopData?["shopImage2Base64"];

final newCover = coverImageDeleted
    ? null
    : (coverImageBase64 ?? oldCover);

final newAvatar = avatarImageDeleted
    ? null
    : (avatarImageBase64 ?? oldAvatar);

    // ✅ مقارنة بيانات المحل
    bool noShopChanges =
    updatedData["shopName"] == (shopData?["shopName"] ?? "") &&
    updatedData["address"] == (shopData?["address"] ?? "") &&
    updatedData["detailes"] == (shopData?["detailes"] ?? "") &&
    listEquals(
      (updatedData["phoneNumbers"] as List<String>?),
      List<String>.from(shopData?["phoneNumbers"] ?? []),
    ) &&
    newCover == oldCover &&
    newAvatar == oldAvatar;

    // ✅ مقارنة بيانات صاحب المحل
    bool noOwnerChanges = true;
    if (_ownerId != null && ownerData != null) {
      noOwnerChanges =
          _ownerNameController.text == (ownerData?["fullName"] ?? "") &&
              _ownerPhoneController.text == (ownerData?["phoneNumber"] ?? "") &&
              _ownerEmailController.text == (ownerData?["email"] ?? "");
    }

    // إذا ما صار أي تعديل
    if (noShopChanges && noOwnerChanges) {
      snackBar(context, "لم يتم تعديل اي بيانات");
      setState(() => isSaving = false); // 🔵 إيقاف التحميل
      Navigator.pop(context, false);
      return;
    }

    // إذا صار تعديل على بيانات المحل
    if (!noShopChanges) {
      final result = await ApiService.updateShop(shopId, updatedData);
      if (result == null || result['status'] != true) {
        snackBar(context, result?['message'] ?? "❌ فشل في حفظ بيانات المحل");
        setState(() => isSaving = false); // 🔵 إيقاف التحميل
        return;
      }
    }

    // إذا صار تعديل على بيانات صاحب المحل
    if (_ownerId != null && !noOwnerChanges) {
      final ownerUpdateData = {
        "shopOwnerId": _ownerId,
        "fullName": _ownerNameController.text,
        "phoneNumber": _ownerPhoneController.text,
        "email": _ownerEmailController.text,
        "profileImageBase64": "",
      };

      final ownerResult = await ApiService.updateOwner(ownerUpdateData);
      if (ownerResult == null || ownerResult['status'] != true) {
        snackBar(context, ownerResult?['message'] ?? "❌ فشل في حفظ بيانات صاحب المحل");
        setState(() => isSaving = false); // 🔵 إيقاف التحميل
        return;
      }

      // 🟢 حفظ رقم الهاتف الجديد قبل الرجوع
      final prefs = await SharedPreferences.getInstance();
      await prefs.setString("phoneNumber", _ownerPhoneController.text);
    }

    // ✅ إذا وصلنا لهون يعني التعديلات نجحت أو تم تعديل جزء منها
    snackBar(context, "تم حفظ التعديلات بنجاح");
    setState(() => isSaving = false); // 🔵 إيقاف التحميل
    Navigator.pop(context, true);
  }
}
