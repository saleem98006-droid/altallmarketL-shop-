  Future<void> _loadShop() async {
  final prefs = await SharedPreferences.getInstance();

  // 🏪 جلب shopId
  final shopId = prefs.getInt('shopId') ?? 0;
  if (shopId == 0) {
    print("⚠️ لم يتم العثور على shopId في التخزين");
    return;
  }

  // 🏪 جلب بيانات المحل
  
  final result = await ApiService.getShopById(shopId);
if (result != null) {
  // 🟢 حفظ Base64 + bytes
  coverImageBase64 = result['shopImageBase64'];
  if (coverImageBase64 != null && coverImageBase64!.isNotEmpty) {
    coverImageBytes = base64Decode(coverImageBase64!);
  }

  avatarImageBase64 = result['shopImage2Base64'];
  if (avatarImageBase64 != null && avatarImageBase64!.isNotEmpty) {
    avatarImageBytes = base64Decode(avatarImageBase64!);
  }

  setState(() {
    shopData = result;
    _nameController.text = result['shopName'] ?? '';
    _addressController.text = result['address'] ?? '';
    _detailsController.text = result['detailes'] ?? '';

    final phones = List<String>.from(result['phoneNumbers'] ?? []);
    phoneControllers =
        phones.map((p) => TextEditingController(text: p)).toList();
    if (phoneControllers.isEmpty) {
      phoneControllers.add(TextEditingController());
    }

    isLoading = false;
  });
}

  // 👤 جلب ownerId
  final ownerId = prefs.getInt('ownerId');
  _ownerId = ownerId ?? 0;

  if (_ownerId != null) {
    final ownerResult = await ApiService.getOwnerById(_ownerId!);
    print("📡 ownerResult from API: $ownerResult");

    if (ownerResult != null) {
      ownerData = ownerResult; // 👈 خزنا نسخة أصلية
      _ownerId = ownerResult['shopOwnerId'] ?? _ownerId;
      _ownerNameController.text = ownerResult['fullName'] ?? '';
      _ownerPhoneController.text = ownerResult['phoneNumber'] ?? '';
      _ownerEmailController.text = ownerResult['email'] ?? '';
    } else {
      print("⚠️ لم يتم جلب بيانات صاحب المحل");
    }
  } else {
    print("⚠️ ownerId غير موجود في SharedPreferences");
  }
}


