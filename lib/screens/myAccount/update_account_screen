                                    if (states.contains(MaterialState.pressed)) {
                                      return const Color(0xFFFF0000);
                                    }
                                    return Colors.white;
                                  },
                                ),
                                foregroundColor:
                                    MaterialStateProperty.resolveWith<Color>(
