Widget _buildHeaderImages(BuildContext context) {
  final screenHeight = MediaQuery.of(context).size.height;
  final screenWidth = MediaQuery.of(context).size.width;

  final double coverHeight = screenHeight * 0.2; 
  final double avatarRadius = 50;

  return SizedBox(
    width: screenWidth,
    height: coverHeight + avatarRadius + 20,
    child: Stack(
      clipBehavior: Clip.none,
      children: [
        // 🔵 صورة الغلاف
GestureDetector(
  onTap: () => _showImageOptions(context, 0),
  child: ClipRRect(
    borderRadius: const BorderRadius.only(
      bottomLeft: Radius.circular(40),
      bottomRight: Radius.circular(40),
    ),
   child: SizedBox(
  width: screenWidth,
  height: coverHeight,
  child: coverImageBytes != null
    ? Image.memory(coverImageBytes!, fit: BoxFit.cover)
    : coverImageDeleted
        ? Container(
            color: Colors.grey[300],
            child: const Icon(Icons.store, size: 80, color: Color(0xFF5A9BD5)),
          )
        : (shopData?['shopImageBase64'] != null &&
                shopData!['shopImageBase64'].toString().isNotEmpty)
            ? Image.memory(base64Decode(shopData!['shopImageBase64']), fit: BoxFit.cover)
            : Container(
                color: Colors.grey[300],
                child: const Icon(Icons.store, size: 80, color: Color(0xFF5A9BD5)),
              ),
),
  ),
),

        // 🔵 الصورة الدائرية
        Positioned(
          top: coverHeight - avatarRadius,
          left: 16,
          child: GestureDetector(
            onTap: () => _showImageOptions(context, 1),
            child: Container(
              decoration: BoxDecoration(
                shape: BoxShape.circle,
                border: Border.all(color: Colors.white, width: 4),
              ),
              child: CircleAvatar(
  radius: avatarRadius,

  // ✨ الصورة (ذاكرة → ثم Base64 → ثم لا شيء)
 backgroundImage: avatarImageBytes != null
    ? MemoryImage(avatarImageBytes!)
    : avatarImageDeleted
        ? null
        : (shopData?['shopImage2Base64'] != null &&
                shopData!['shopImage2Base64'].toString().isNotEmpty)
            ? MemoryImage(base64Decode(shopData!['shopImage2Base64']))
            : null,
),
            ),
          ),
        ),
      ],
    ),
  );
}



