                                    const SnackBar(
                                        content: Text("يجب إدخال كلمة المرور الجديدة")),
                                  );
                                  return;
                                }

                                final result =
                                    await ApiService.changeOwnerPassword(
                                  _ownerId!,
                                  oldPassController.text,
                                  newPassController.text,
                                );

                                Navigator.pop(context);

                               
                                snackBar(context, result?['message'] ??
                                          " فشل في تغيير كلمة المرور");
