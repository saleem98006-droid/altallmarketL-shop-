 Future<void> _pickImage(int index) async {
  final pickedFile = await _picker.pickImage(source: ImageSource.gallery);
  if (pickedFile == null) return;

  final file = File(pickedFile.path);
  final bytes = await file.readAsBytes();
  final compressedBase64 = await ImageCompressor.compressFile(file);

  setState(() {
    if (index == 0) {
      coverImageBase64 = compressedBase64;
      coverImageBytes = bytes;
    } else {
      avatarImageBase64 = compressedBase64;
      avatarImageBytes = bytes;
    }
  });
}


  Future<String?> _encodeImage(File? file) async {
  if (file == null) return null;

  try {
    return await ImageCompressor.compressFile(file);
  } catch (e) {
    return null;
  }
}

 














